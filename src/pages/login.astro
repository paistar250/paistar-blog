---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
import '../styles/auth.css';
---
<BaseLayout title="登录演示" description="在此浏览器体验本地演示账号。文章公开可读，无需登录。">
  <div class="auth-wrap">
    <div class="auth-art"><span class="art-mark">PAISTAR / PERSONAL JOURNAL</span><div class="auth-orbit" aria-hidden="true"></div><div><h1>回来啦，<br />随便坐坐。</h1><p>这里记录技术、阅读和生活。账号只是一个小小的本地演示，文章始终对访客开放。</p></div><div class="art-foot"><span>KEEP THE LIGHT ON</span><span>✳</span></div></div>
    <section class="auth-form-panel" aria-labelledby="login-heading"><span class="eyebrow">WELCOME BACK</span><h2 id="login-heading">登录你的演示账号<span class="accent-dot">.</span></h2><p class="lead">状态只保存在当前浏览器，不会发送到服务器。</p>
      <div class="signed-in" data-signed-in hidden><p>已经以 <strong data-session-name></strong> 的身份登录。</p><button type="button" data-signout>退出登录</button></div>
      <form class="auth-form" data-login><label>邮箱<input name="email" type="email" autocomplete="username" placeholder="name@example.com" required /></label><label>密码<input name="password" type="password" autocomplete="current-password" placeholder="至少 8 个字符" required /></label><label class="remember"><input name="remember" type="checkbox" /> 记住登录状态（关闭浏览器后仍保留）</label><button class="button auth-submit" type="submit">登录演示 ↗</button><p class="auth-status" role="alert" aria-live="polite"></p></form>
      <p class="auth-switch">还没有演示账号？<a href={withBase('/signup/')}>在此浏览器注册 ↗</a></p>
      <p class="auth-disclosure"><strong>本地演示，不用于保护内容。</strong> 账号数据仅存于此浏览器；清除站点数据后将丢失。博客文章<a href={withBase('/archive/')}>无需登录即可阅读</a>，请勿使用真实常用密码。</p>
      <button class="cat-secret" type="button" data-secret-cat aria-label="轻点小猫进入访客演示">◕⩊◕ <span>小猫也在等你</span></button>
    </section>
  </div>
  <script>
    import { login, getSession, logout, enterCatDemo } from '../lib/demo-auth';
    const form=document.querySelector<HTMLFormElement>('[data-login]');
    const signed=document.querySelector<HTMLElement>('[data-signed-in]');
    const name=document.querySelector<HTMLElement>('[data-session-name]');
    const status=document.querySelector<HTMLElement>('.auth-status');
    function showSession(){const session=getSession();if(form)form.hidden=Boolean(session);if(signed)signed.hidden=!session;if(name&&session)name.textContent=session.name}
    showSession();
    if(new URLSearchParams(location.search).has('registered')&&status){status.textContent='注册成功，请登录。';status.classList.add('success')}
    form?.addEventListener('submit',async event=>{event.preventDefault();if(!status)return;const data=new FormData(form);const button=form.querySelector<HTMLButtonElement>('button[type=submit]');if(button)button.disabled=true;status.textContent='正在验证…';try{await login(String(data.get('email')||''),String(data.get('password')||''),data.get('remember')==='on');location.href='/'}catch(error){status.textContent=error instanceof Error?error.message:'登录失败，请重试。';if(button)button.disabled=false}});
    document.querySelector<HTMLButtonElement>('[data-signout]')?.addEventListener('click',()=>{logout();showSession();if(status)status.textContent='已退出登录。'});
    let catTaps=0;const cat=document.querySelector<HTMLButtonElement>('[data-secret-cat]');cat?.addEventListener('click',()=>{catTaps++;if(catTaps>=5){try{enterCatDemo();location.href='/'}catch{if(status)status.textContent='浏览器未允许保存演示状态。'}}else if(status)status.textContent=`再摸 ${5-catTaps} 次，小猫会带你进入访客演示。`});
  </script>
</BaseLayout>
