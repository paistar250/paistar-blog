---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---
<BaseLayout title="搜索"><PageHeader title="🔎 搜索文章" artwork="reading"/><section class="narrow panel search-panel" data-base={import.meta.env.BASE_URL} data-pagefind-ignore><label class="search-label" for="search-input">关键词</label><div class="search-box"><span aria-hidden="true">⌕</span><input id="search-input" type="search" placeholder="搜点什么…" autocomplete="off"/></div><p id="search-status" role="status" aria-live="polite"></p><div id="search-results" class="search-results"></div></section><script is:inline type="module" src="/search.js"></script></BaseLayout>
<style>.search-label{font-size:.8rem;display:block;margin-bottom:10px;color:var(--muted)}.search-box{display:flex;align-items:center;gap:12px;padding:9px 17px;border:1px solid var(--line);border-radius:99px;background:var(--bg)}.search-box:focus-within{border-color:var(--accent)}.search-box>span{font-size:1.6rem;line-height:1;color:var(--accent)}.search-box input{width:100%;min-width:0;padding:6px 0;border:0;outline:0;background:transparent;color:var(--text);font-size:.9rem}#search-status{color:var(--muted);font-size:.8rem;min-height:20px;margin:20px 0 5px}.search-result{display:grid;grid-template-columns:1fr 18px;gap:5px 12px;padding:20px 0;border-top:1px solid var(--line)}.search-result strong{font-size:1rem;font-weight:600}.search-result span:nth-child(2){grid-column:1;color:var(--muted);font-size:.8rem}.search-result span:nth-child(3){grid-column:2;grid-row:1;color:var(--accent)}</style>
