---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---
<BaseLayout title="站内搜索" description="在 Paistar 手记中搜索文章。搜索索引由构建时生成，无需服务器。">
  <div class="shell page-hero"><span class="eyebrow">FIND SOMETHING GOOD</span><h1>站内搜索</h1><p>搜索标题与正文。所有索引都随静态网站一起发布，不会上传你的搜索词。</p></div>
  <section class="narrow search-panel" data-base={import.meta.env.BASE_URL} data-pagefind-ignore><label for="search-input">想找点什么？</label><div class="search-box"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input id="search-input" type="search" placeholder="试试：Astro、设计、阅读…" autocomplete="off" autofocus /></div><p id="search-status" role="status" aria-live="polite">开始输入关键词。</p><div id="search-results" class="search-results"></div></section>
  <script is:inline type="module" src={withBase('/search.js')}></script>
</BaseLayout>
<style>.search-panel{padding:28px;border:1px solid var(--line);border-radius:20px;background:var(--surface)}.search-panel label{display:block;margin-bottom:12px;font-weight:750}.search-box{display:flex;align-items:center;gap:13px;padding:10px 16px;border:1px solid var(--line);border-radius:12px;background:var(--bg)}.search-box:focus-within{border-color:var(--accent)}.search-box svg{width:21px;height:21px;fill:none;stroke:var(--accent);stroke-width:1.8;stroke-linecap:round}.search-box input{width:100%;padding:8px 0;border:0;outline:0;background:transparent;color:var(--text)}#search-status{min-height:1.5em;margin:22px 0 12px;color:var(--muted);font-size:.9rem}.search-results{display:grid}.search-result{display:grid;grid-template-columns:1fr 18px;gap:4px 12px;padding:18px 0;border-top:1px solid var(--line)}.search-result strong{font-size:1.08rem}.search-result span:nth-child(2){grid-column:1;color:var(--muted);font-size:.89rem}.search-result span:nth-child(3){grid-column:2;grid-row:1;color:var(--accent)}</style>
