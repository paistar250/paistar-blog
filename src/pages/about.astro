---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { art } from '../data/art';
---
<BaseLayout title="关于"><PageHeader title="👋 你好，我是 Paistar" subtitle="技术 · 阅读 · 日常" artwork="notes"/><div class="narrow panel about-card"><div class="about-intro"><img src="/avatar.webp" alt="Paistar 的头像" width="90" height="90"/><div><h2>Paistar</h2><p>喜欢折腾技术，也喜欢记录生活。<br/>这里放笔记、想法和偶尔的碎碎念。</p></div></div><div class="about-links"><a href="/categories/tech/">💻 技术札记</a><a href="/categories/reading/">📖 读书笔记</a><a href="/categories/life/">🌿 生活随笔</a></div><Image class="about-photo" src={art.life} alt="夕阳里的山坡与房屋" width={1100} height={430} format="webp" quality={84}/><div class="about-bottom"><a href="/contact/">📮 联系我 →</a><a href="/archive/">🗂️ 所有文章 →</a></div></div><div class="narrow asset-credit">插画 <a href="https://openmoji.org/" target="_blank" rel="noopener noreferrer">OpenMoji</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a> · 场景 <a href="https://www.ghibli.jp/works/" target="_blank" rel="noopener noreferrer">Studio Ghibli</a></div></BaseLayout>
<style>.about-intro{display:flex;gap:25px;align-items:center;padding:10px 5px 25px}.about-intro img{flex-shrink:0;border-radius:50%;object-fit:cover;box-shadow:0 4px 15px #00000016}.about-card h2{margin:0 0 6px;font-size:1.5rem;font-weight:600}.about-card p{color:var(--muted);font-size:.9rem;margin:0;line-height:1.9}.about-links{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:26px}.about-links a{padding:7px 14px;background:var(--surface-2);border-radius:99px;font-size:.78rem}.about-photo{width:100%;height:260px;object-fit:cover;border-radius:12px}.about-bottom{display:flex;justify-content:space-between;gap:15px;margin-top:23px;font-size:.8rem;color:var(--muted)}.asset-credit{margin-top:18px;color:var(--muted);font-size:.65rem;text-align:center}.asset-credit a{text-decoration:underline;text-underline-offset:3px}@media(max-width:560px){.about-intro{gap:14px;align-items:start}.about-intro img{width:60px;height:60px}.about-card p{font-size:.82rem}.about-photo{height:190px}}</style>
