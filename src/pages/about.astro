---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
import { site } from '../data/site';
---
<BaseLayout title="关于" description="了解 Paistar 手记和它记录的主题。">
<div class="shell about">
  <div class="about-heading"><div><span class="eyebrow">ABOUT / THE PERSON BEHIND THE WORDS</span><h1>你好，我是<br /><em>{site.author}。</em></h1><p>一个喜欢把问题想清楚、把日常写下来的人。这里是我持续整理想法的小小角落。</p><a class="button" href={withBase('/archive/')}>从文章开始认识我 ↗</a></div><div class="about-portrait" aria-label="由几何图形组成的作者标记"><span class="portrait-ring" aria-hidden="true"></span><span class="portrait-eye" aria-hidden="true"></span><span class="portrait-quote">记录是一种<br />温柔的整理。</span><small>PAISTAR / 2026 —</small></div></div>
  <div class="about-grid"><section class="about-note"><span class="eyebrow">A NOTE TO VISITORS</span><h2>慢一点，也没关系。</h2><p>这个站点不追逐更新频率。我更想把实践中的过程、阅读后的疑问和生活里容易被忽略的细节留在这里。偶尔回头看，会发现一段文字仍能告诉我们当时如何思考。</p></section><section class="about-topics"><span class="eyebrow">THREE WAYS TO WANDER</span><h2>从感兴趣的地方读起。</h2><a href={withBase('/categories/tech/')}><span>✳</span><strong>技术札记</strong><small>过程、实践和复盘</small><b>↗</b></a><a href={withBase('/categories/reading/')}><span>◈</span><strong>读书笔记</strong><small>问题和旁注</small><b>↗</b></a><a href={withBase('/categories/life/')}><span>⌁</span><strong>生活随笔</strong><small>平凡日子的细节</small><b>↗</b></a></section></div>
  <div class="about-end"><div><span class="eyebrow">BEHIND THIS SITE</span><h2>文字公开，维护简单。</h2><p>网站使用 Astro 构建，Markdown/MDX 写文章，GitHub Pages 托管。搜索、RSS 和站点地图在构建时生成。这里没有文章权限系统：所有文字对访客开放。本地演示账号只保存在当前浏览器，不用于保护内容。</p></div><div class="about-end-links"><a href={withBase('/search/')}>搜索文章 ↗</a><a href={withBase('/contact/')}>联系我 ↗</a><a href={withBase('/rss.xml')}>订阅 RSS ↗</a></div></div>
</div>
</BaseLayout>
<style>
.about{padding-top:74px}.about-heading{display:grid;grid-template-columns:1.08fr .92fr;gap:42px;align-items:center}.about-heading h1{margin:17px 0 18px;font-size:clamp(3.5rem,7vw,7rem);line-height:1.08;letter-spacing:-.09em}.about-heading h1 em{color:var(--accent);font-style:normal}.about-heading p{max-width:450px;color:var(--muted);font-size:1.05rem;line-height:1.9}.about-heading .button{margin-top:22px}.about-portrait{position:relative;min-height:490px;overflow:hidden;padding:32px;border:1px solid var(--line);border-radius:28px;background:#c7bdf0;color:#282536}.portrait-ring{position:absolute;width:420px;height:420px;right:-110px;top:-95px;border:1px solid #7065ad;border-radius:50%;box-shadow:0 0 0 35px #766bb432,0 0 0 70px #766bb424,0 0 0 105px #766bb416}.portrait-eye{position:absolute;top:120px;left:84px;width:76px;height:76px;border:13px solid #353147;border-radius:50%;transform:rotate(-22deg)}.portrait-eye:after{content:'';position:absolute;right:-57px;bottom:-44px;width:90px;height:14px;border-radius:20px;background:#353147;transform:rotate(-30deg)}.portrait-quote{position:absolute;left:32px;bottom:74px;font-family:Georgia,'Songti SC',serif;font-size:clamp(1.8rem,3vw,3.2rem);line-height:1.45;font-style:italic}.about-portrait small{position:absolute;left:32px;bottom:30px;font-size:.68rem;letter-spacing:.15em}
.about-grid{display:grid;grid-template-columns:.86fr 1.14fr;gap:14px;margin-top:48px}.about-note,.about-topics{padding:32px;border:1px solid var(--line);border-radius:25px;background:var(--surface)}.about-grid h2,.about-end h2{margin:26px 0 12px;font-size:clamp(1.7rem,2.5vw,2.4rem);line-height:1.25;letter-spacing:-.06em}.about-note p,.about-end p{color:var(--muted);line-height:1.9}.about-topics a{display:grid;grid-template-columns:30px 1fr 1.3fr 16px;gap:11px;align-items:center;padding:15px 0;border-top:1px solid var(--line)}.about-topics a:hover{color:var(--accent)}.about-topics a>span{color:var(--accent)}.about-topics strong{font-size:.9rem}.about-topics small{color:var(--muted)}.about-topics b{font-weight:400}
.about-end{display:flex;justify-content:space-between;gap:40px;margin-top:48px;padding:44px 0;border-block:1px solid var(--line)}.about-end>div:first-child{max-width:650px}.about-end-links{display:flex;flex-direction:column;gap:12px;align-self:center;min-width:160px}.about-end-links a{padding:11px 0;border-bottom:1px solid var(--line);font-size:.85rem}.about-end-links a:hover{color:var(--accent)}
@media(max-width:760px){.about{padding-top:55px}.about-heading,.about-grid{grid-template-columns:1fr}.about-portrait{min-height:320px}.about-end{display:block}.about-end-links{margin-top:25px}}@media(max-width:450px){.about-topics a{grid-template-columns:25px 1fr 17px}.about-topics small{grid-column:2;grid-row:2}.about-topics b{grid-column:3;grid-row:1}}
</style>
