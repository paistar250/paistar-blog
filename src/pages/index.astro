---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts, postUrl, categories, termSlug, formatDate } from '../lib/blog';
import { withBase } from '../lib/url';
import { site } from '../data/site';

const posts = await getPosts();
const featured = posts.find((post) => post.data.featured) || posts[0];
const latest = posts.filter((post) => post.id !== featured.id).slice(0, 3);
const categoryList = categories(posts);
const schema = { '@context': 'https://schema.org', '@type': 'Blog', name: site.title, description: site.description, url: new URL(withBase('/'), Astro.site).toString(), author: { '@type': 'Person', name: site.author } };
---
<BaseLayout schema={schema}>
  <section class="home-hero shell">
    <div class="hero-copy">
      <div class="hero-kicker"><span class="kicker-dot"></span> PERSONAL BLOG <span class="kicker-rule"></span> 2026 · 至今</div>
      <h1>在日常里发现<br /><em>值得记录的光。</em></h1>
      <p>你好，我是 Paistar。这里写技术、阅读与生活，也收集那些没有标准答案，却值得慢慢想的问题。</p>
      <div class="hero-actions"><a class="button" href={withBase('/archive/')}>开始阅读 <span aria-hidden="true">↗</span></a><a class="quiet-link" href={withBase('/about/')}>认识作者 <span aria-hidden="true">→</span></a></div>
    </div>
    <div class="hero-art" aria-hidden="true"><div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div><div class="art-sun"></div><div class="art-hill hill-back"></div><div class="art-hill hill-front"></div><span class="art-label top-label">CURIOUS MIND / 001</span><span class="art-label bottom-label">Collect moments, make meaning.</span><span class="art-star">✳</span></div>
  </section>

  <section class="featured-section shell" aria-labelledby="featured-title">
    <div class="section-heading"><div><span class="eyebrow">EDITOR'S PICK</span><h2 id="featured-title">先读这一篇</h2></div><span class="section-index">01 / 03</span></div>
    <a class="featured-card" href={withBase(postUrl(featured))}><div class="featured-number">01<span>/ FEATURED</span></div><div class="featured-main"><span class="eyebrow">{featured.data.category} · {formatDate(featured.data.date)}</span><h3>{featured.data.title}</h3><p>{featured.data.description}</p><span class="featured-read">阅读文章 <span aria-hidden="true">↗</span></span></div><div class="featured-icon" aria-hidden="true">✦</div></a>
  </section>

  <section class="latest-section shell" aria-labelledby="latest-title"><div class="section-heading"><div><span class="eyebrow">FRESHLY WRITTEN</span><h2 id="latest-title">最近更新</h2></div><a class="text-link" href={withBase('/archive/')}>查看全部文章 ↗</a></div><div class="post-grid">{latest.map((post, index) => <PostCard post={post} index={index} />)}</div></section>

  <section class="browse-section shell"><div><span class="eyebrow">EXPLORE</span><h2>循着兴趣，慢慢翻阅。</h2><p>每篇文字都有自己的位置。从一个主题出发，或许会遇见意料之外的下一篇。</p></div><div class="browse-list">{categoryList.map((category, index) => <a href={withBase(`/categories/${termSlug(category.name)}/`)}><span class="browse-number">0{index + 1}</span><strong>{category.name}</strong><span>{category.count} 篇文章</span><span aria-hidden="true">↗</span></a>)}</div></section>

  <section class="newsletter shell"><div><span class="eyebrow">STAY CURIOUS</span><h2>不急着赶路，偶尔回来看一看。</h2><p>通过 RSS 订阅新文章。无弹窗，无邮件营销，只留下真正想读的内容。</p></div><a class="button button-secondary" href={withBase('/rss.xml')}>订阅 RSS ↗</a></section>
</BaseLayout>

<style>
  .home-hero { min-height:620px; display:grid; grid-template-columns:1.12fr .88fr; gap:42px; align-items:center; padding-block:74px 66px; }
  .hero-kicker { display:flex; align-items:center; gap:11px; color:var(--accent); font-size:.74rem; font-weight:800; letter-spacing:.17em; } .kicker-dot { width:8px; height:8px; border-radius:50%; background:var(--warm); } .kicker-rule { width:34px; height:1px; background:var(--line); }
  h1 { margin:30px 0 25px; font-size:clamp(3rem,5.7vw,5.25rem); line-height:1.17; letter-spacing:-.09em; font-weight:800; } h1 em { color:var(--accent); font-style:normal; } .hero-copy>p { max-width:540px; margin:0; color:var(--muted); font-size:1.08rem; line-height:1.95; } .hero-actions { display:flex; align-items:center; flex-wrap:wrap; gap:26px; margin-top:36px; } .quiet-link { color:var(--accent); font-weight:700; }
  .hero-art { position:relative; width:100%; aspect-ratio:1.08; overflow:hidden; border:1px solid #9bb7ad; border-radius:26px; background:linear-gradient(145deg,#e3ede6,#bdcfc0 58%,#91b4a7); box-shadow:var(--shadow); } .art-sun { position:absolute; width:38%; aspect-ratio:1; top:23%; right:23%; border-radius:50%; background:#f4e9cd; box-shadow:0 0 65px #f4e9cd77; } .art-orbit { position:absolute; border:1px solid #ffffff88; border-radius:50%; transform:rotate(-22deg); } .orbit-one { inset:-40% -15%; } .orbit-two { inset:-17% 7%; } .art-hill { position:absolute; width:125%; height:55%; bottom:-25%; left:-10%; border-radius:50% 50% 0 0; transform:rotate(-9deg); } .hill-back { bottom:-18%; left:-31%; background:#79a99b; transform:rotate(12deg); } .hill-front { background:#35695f; } .art-label { position:absolute; z-index:2; color:#285f55; font-family:Georgia,serif; font-size:.73rem; letter-spacing:.13em; } .top-label { top:27px; left:29px; } .bottom-label { bottom:23px; right:27px; color:#eff8ec; } .art-star { position:absolute; right:11%; top:10%; color:#f1f6e9; font-size:2rem; }
  .featured-section,.latest-section { padding-top:46px; } .section-index { color:var(--muted); font-family:Georgia,serif; font-size:.9rem; } .featured-card { display:grid; grid-template-columns:120px 1fr 125px; min-height:320px; gap:25px; align-items:center; padding:40px 50px; border-radius:24px; background:var(--accent); color:#f1f7f3; overflow:hidden; position:relative; } .featured-card:hover { color:#fff; } .featured-number { align-self:start; font-family:Georgia,serif; font-size:3.6rem; line-height:1; opacity:.7; } .featured-number span { display:block; margin-top:10px; font-family:inherit; font-size:.58rem; letter-spacing:.18em; } .featured-main { position:relative; z-index:2; } .featured-main .eyebrow { color:#b9ddce; } .featured-main h3 { max-width:650px; margin:14px 0 11px; font-size:clamp(1.8rem,3.4vw,3rem); line-height:1.27; letter-spacing:-.05em; } .featured-main p { max-width:500px; color:#d8e9df; } .featured-read { display:inline-block; margin-top:17px; font-weight:800; } .featured-icon { position:absolute; right:-30px; top:-117px; font-size:22rem; line-height:1; color:#ffffff12; }
  .browse-section { display:grid; grid-template-columns:1fr 1.1fr; gap:60px; align-items:center; margin-top:115px; padding:58px 0; border-block:1px solid var(--line); } .browse-section h2,.newsletter h2 { max-width:450px; margin:14px 0 16px; font-size:clamp(1.9rem,3.4vw,2.8rem); line-height:1.3; letter-spacing:-.06em; } .browse-section p,.newsletter p { max-width:440px; color:var(--muted); } .browse-list { border-top:1px solid var(--line); } .browse-list a { display:grid; grid-template-columns:42px 1fr 90px 20px; gap:14px; align-items:center; padding:20px 5px; border-bottom:1px solid var(--line); } .browse-list a:hover { padding-left:13px; } .browse-number,.browse-list a>span:nth-child(3) { color:var(--muted); font-size:.8rem; } .browse-list strong { font-size:1.1rem; }
  .newsletter { margin-top:100px; padding:40px 44px; display:flex; align-items:center; justify-content:space-between; gap:25px; border:1px solid var(--line); border-radius:22px; background:var(--surface); } .newsletter p { margin-bottom:0; }
  @media(max-width:860px) { .home-hero { grid-template-columns:1fr; min-height:0; } .hero-art { max-width:600px; aspect-ratio:1.5; } .browse-section { gap:25px; } } @media(max-width:620px) { .home-hero { padding-top:56px; gap:40px; } .hero-art { aspect-ratio:1.1; } .featured-card { grid-template-columns:1fr; padding:30px; gap:20px; } .featured-number { font-size:2rem; } .featured-icon { font-size:15rem; } .browse-section { grid-template-columns:1fr; margin-top:70px; } .newsletter { margin-top:70px; display:block; padding:28px; } .newsletter .button { margin-top:18px; } }
</style>
