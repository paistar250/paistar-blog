---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, postUrl, categories, tags, formatShortDate } from '../lib/blog';
import { withBase } from '../lib/url';
import { site } from '../data/site';
const posts = await getPosts();
const pinned = posts.find(p => p.data.pinned) ?? posts[0];
const featured = posts.find(p => p.data.featured && p.id !== pinned.id) ?? posts.find(p => p.id !== pinned.id) ?? pinned;
const latest = posts.slice(0, 4);
const categoryList = categories(posts);
const tagList = tags(posts).slice(0, 10);
const years = [...new Set(posts.map(p => p.data.date.getFullYear()))];
const schema = { '@context':'https://schema.org', '@type':'Blog', name:site.title, description:site.description, url:new URL(withBase('/'), Astro.site).toString(), author:{ '@type':'Person', name:site.author } };
---
<BaseLayout schema={schema}>
<div class="home shell">
  <div class="home-top"><div><span class="eyebrow">PERSONAL JOURNAL / SINCE 2026</span><h1>把日子写成<br /><span>可以回来的地方<span class="accent-dot">.</span></span></h1></div><a class="home-search" href={withBase('/search/')}><span aria-hidden="true">⌕</span> 搜索站内文章 <b>↗</b></a></div>
  <div class="bento-grid">
    <section class="bento-card intro"><div class="card-top"><span>01 / 关于我</span><span aria-hidden="true">✳</span></div><div class="intro-copy"><span class="eyebrow">你好，我是 Paistar ✦</span><h2>持续记录，<br />偶尔绕远路。</h2><p>写技术里的细节，读书时的旁注，也写生活中那些微小却真实的瞬间。这里不赶更新频率，只希望每篇文字都值得留存。</p><div class="intro-actions"><a class="button" href={withBase('/about/')}>认识我 ↗</a><a href={withBase('/rss.xml')}>订阅 RSS ↗</a></div></div><div class="intro-orbit" aria-hidden="true">THOUGHTS<br />IN MOTION ↗</div></section>
    <section class="bento-card note"><div class="card-top"><span>置顶 / 给路过的人</span><span aria-hidden="true">●</span></div><a href={withBase(postUrl(pinned))}><span class="hand">别急，先坐一会儿。</span><h2>{pinned.data.title}</h2><p>{pinned.data.description}</p><span class="note-link">读这篇置顶文章 ↗</span></a></section>
    <section class="bento-card latest"><div class="card-top"><span>02 / 最近记录</span><a href={withBase('/archive/')}>全部 ↗</a></div><h2>刚写下的<span class="accent-dot">.</span></h2><div class="latest-list">{latest.map((post,i) => <a href={withBase(postUrl(post))}><small>0{i+1}</small><span>{post.data.title}<em>{post.data.category} · {formatShortDate(post.data.date)}</em></span><b aria-hidden="true">↗</b></a>)}</div></section>
    <a class="bento-card feature" href={withBase(postUrl(featured))}><div class="card-top"><span>精选文章 / EDITOR'S PICK</span><span aria-hidden="true">↗</span></div><div class="feature-art" aria-hidden="true"></div><div class="feature-copy"><small>{featured.data.category} · {formatShortDate(featured.data.date)}</small><h2>{featured.data.title}</h2><p>{featured.data.description}</p><strong>打开文章 ↗</strong></div></a>
    <section class="bento-card categories"><div class="card-top"><span>03 / 主题分类</span><a href={withBase('/categories/')}>浏览全部 ↗</a></div><h2>从一个主题开始。</h2><div class="category-list">{categoryList.map((item,i) => <a href={withBase(`/categories/${item.slug}/`)}><span class="category-icon">{['✳','◈','⌁'][i%3]}</span><strong>{item.name}</strong><small>{item.count} 篇</small><span>↗</span></a>)}</div></section>
    <section class="bento-card timeline"><div class="card-top"><span>04 / 时间线</span><a href={withBase('/archive/')}>归档 ↗</a></div><h2>写过的日子</h2><p>文章沿时间排开，重新翻看，也许会遇见当时的自己。</p>{years.map(year => <a class="year" href={withBase(`/archive/#year-${year}`)}><strong>{year}</strong><small>{posts.filter(p=>p.data.date.getFullYear()===year).length} 篇记录</small><span>↗</span></a>)}</section>
    <section class="bento-card cat"><div class="card-top"><span>小小的互动</span><span aria-hidden="true">♥</span></div><button class="cat-button" type="button" aria-label="轻点小猫" data-cat><span class="cat-ears"></span><span class="cat-face"><i></i><i></i><b>ω</b></span></button><h2>这里有只猫。</h2><p data-cat-message>摸摸它，它会给你一句今天的话。</p><a href={withBase('/about/')}>顺便认识作者 ↗</a></section>
    <section class="bento-card tags"><div class="card-top"><span>05 / 文章标签</span><a href={withBase('/tags/')}>所有标签 ↗</a></div><h2>一些反复出现的词。</h2><div class="tag-cloud">{tagList.map(tag => <a href={withBase(`/tags/${tag.slug}/`)}># {tag.name} <small>{tag.count}</small></a>)}</div></section>
    <section class="bento-card closing"><div class="card-top"><span>继续逛逛</span><span aria-hidden="true">↗</span></div><div><h2>在一篇文字里<br />停留片刻。</h2><p>所有文章都可直接阅读。想找特定内容，可以搜索、按主题翻阅，或从第一篇开始。</p><div><a href={withBase('/archive/')}>浏览归档 ↗</a><a href={withBase('/search/')}>站内搜索 ↗</a></div></div></section>
  </div>
</div>
<script>
const cat=document.querySelector('[data-cat]');
const msg=document.querySelector('[data-cat-message]');
const sayings=['今天也可以慢一点。','好奇心会带你去有趣的地方。','一段小记录，也是给未来的礼物。','喵。记得去读一篇文章！'];
let taps=0; cat?.addEventListener('click',()=>{if(msg)msg.textContent=sayings[taps++%sayings.length];cat.classList.toggle('happy')});
</script>
</BaseLayout>
<style>
.home{padding:70px 0 30px}.home-top{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:32px}h1{margin:16px 0 0;font-size:clamp(3rem,6vw,6.2rem);line-height:1.08;letter-spacing:-.085em}h1 span{color:var(--muted)}.home-search{display:flex;gap:12px;align-items:center;min-width:250px;margin-bottom:7px;padding:11px 16px;border:1px solid var(--line);border-radius:99px;background:var(--surface);color:var(--muted);font-size:.83rem}.home-search span{font-size:1.6rem;line-height:1}.home-search b{margin-left:auto;color:var(--accent)}
.bento-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:14px}.bento-card{position:relative;min-width:0;overflow:hidden;padding:28px 30px;border:1px solid var(--line);border-radius:27px;background:var(--surface);transition:transform .3s,border-color .3s,box-shadow .3s}.bento-card:hover{border-color:var(--accent);box-shadow:var(--shadow)}.card-top{position:relative;z-index:2;display:flex;justify-content:space-between;gap:12px;color:var(--muted);font-size:.7rem;font-weight:780;letter-spacing:.08em}.card-top a{color:var(--muted)}.card-top a:hover{color:var(--accent)}
.intro{grid-column:span 7;min-height:405px;background:radial-gradient(circle at 84% 8%,#c2b6ef22,transparent 43%),var(--surface)}.intro-copy{position:relative;z-index:2;max-width:510px;margin-top:50px}.intro h2{margin:12px 0 13px;font-size:clamp(2.4rem,4.3vw,4.1rem);line-height:1.12;letter-spacing:-.075em}.intro p{max-width:440px;margin:0;color:var(--muted);font-size:.91rem}.intro-actions{display:flex;align-items:center;gap:18px;margin-top:24px;font-size:.78rem}.intro-actions>a:last-child{color:var(--muted)}.intro-orbit{position:absolute;right:30px;top:76px;display:grid;place-items:center;width:125px;height:125px;border:1px solid var(--line);border-radius:50%;color:var(--muted);transform:rotate(17deg);font-size:.57rem;text-align:center;letter-spacing:.13em}
.note{grid-column:span 5;min-height:405px;background:#dce9b9;color:#25302a;border-color:#dce9b9}.note .card-top{color:#4d6548}.note>a{display:block;padding-top:39px;color:inherit}.hand{display:block;color:#536448;font:italic 1.38rem Georgia,'Songti SC',serif;transform:rotate(-3deg)}.note h2{max-width:370px;margin:24px 0 10px;font-size:clamp(1.7rem,2.8vw,2.55rem);line-height:1.23;letter-spacing:-.06em}.note p{color:#51614d;font-size:.9rem}.note-link{display:inline-block;margin-top:13px;padding-bottom:3px;border-bottom:1px solid #52614d;font-size:.8rem;font-weight:760}
.latest{grid-column:span 5;min-height:400px}.latest h2,.categories h2,.timeline h2,.tags h2{margin:30px 0 16px;font-size:1.7rem;letter-spacing:-.06em}.latest-list a{display:grid;grid-template-columns:24px 1fr 17px;gap:10px;padding:12px 0;border-top:1px solid var(--line);font-size:.85rem;font-weight:700;line-height:1.4}.latest-list a:hover{color:var(--accent)}.latest-list small{color:var(--accent);font-size:.67rem}.latest-list em{display:block;margin-top:4px;color:var(--muted);font-size:.65rem;font-style:normal;font-weight:500}.latest-list b{color:var(--muted);font-weight:400}
.feature{grid-column:span 7;min-height:400px;display:flex;flex-direction:column;justify-content:space-between;background:#c8bef1;color:#242333;border-color:#c8bef1}.feature:hover{color:#242333;transform:translateY(-3px)}.feature .card-top{color:#534f72}.feature-copy{position:relative;z-index:2;max-width:480px}.feature-copy small{color:#59547e;font-weight:700}.feature h2{margin:10px 0;font-size:clamp(2rem,3.3vw,3.2rem);line-height:1.2;letter-spacing:-.07em}.feature p{max-width:390px;color:#4f4d63;font-size:.87rem}.feature strong{display:inline-block;margin-top:12px;border-bottom:1px solid #242333;font-size:.8rem}.feature-art{position:absolute;right:-125px;top:-50px;width:400px;height:400px;border:2px solid #7770ae77;border-radius:50%;box-shadow:0 0 0 34px #7770ae25,0 0 0 70px #7770ae20,0 0 0 105px #7770ae13}
.categories{grid-column:span 5;min-height:350px}.category-list{margin-top:18px}.category-list a{display:grid;grid-template-columns:34px 1fr auto 15px;gap:9px;align-items:center;padding:10px 0;border-top:1px solid var(--line)}.category-list a:hover strong{color:var(--accent)}.category-icon{display:grid;place-items:center;width:29px;height:29px;border-radius:9px;background:var(--surface-3);color:var(--accent)}.category-list strong{font-size:.85rem}.category-list small{color:var(--muted);font-size:.7rem}
.timeline{grid-column:span 4;min-height:350px}.timeline p{max-width:250px;color:var(--muted);font-size:.84rem}.year{display:flex;align-items:center;gap:12px;margin-top:25px;padding:12px 0;border-top:1px solid var(--line)}.year strong{color:var(--accent);font-size:1.4rem}.year small{color:var(--muted)}.year span{margin-left:auto}
.cat{grid-column:span 3;min-height:350px;background:var(--surface-2)}.cat-button{position:relative;display:block;width:116px;height:110px;margin:24px auto 7px;border:0;background:none;transition:transform .3s}.cat-button:hover,.cat-button.happy{transform:rotate(-9deg) scale(1.05)}.cat-ears:before,.cat-ears:after{content:'';position:absolute;top:8px;width:38px;height:43px;background:var(--accent);border-radius:8px 80% 0 0}.cat-ears:before{left:12px;transform:rotate(-20deg)}.cat-ears:after{right:12px;transform:rotate(110deg)}.cat-face{position:absolute;inset:27px 7px 4px;border-radius:43% 43% 48% 48%;background:var(--accent)}.cat-face i{position:absolute;top:33px;width:7px;height:11px;border-radius:50%;background:var(--accent-ink)}.cat-face i:first-child{left:29px}.cat-face i:nth-child(2){right:29px}.cat-face b{position:absolute;top:37px;left:50%;transform:translateX(-50%);color:var(--accent-ink);font-size:27px;font-weight:400}.cat h2{margin:4px 0;font-size:1.18rem}.cat p{min-height:42px;margin:0;color:var(--muted);font-size:.76rem}.cat>a{color:var(--accent);font-size:.7rem;font-weight:700}
.tags{grid-column:span 5;min-height:300px}.tag-cloud{display:flex;flex-wrap:wrap;gap:8px;margin-top:23px}.tag-cloud a{padding:6px 11px;border:1px solid var(--line);border-radius:99px;background:var(--surface-2);font-size:.76rem}.tag-cloud a:hover{color:var(--accent);border-color:var(--accent)}.tag-cloud small{margin-left:4px;color:var(--muted)}
.closing{grid-column:span 7;min-height:300px;display:flex;flex-direction:column;justify-content:space-between;background:radial-gradient(circle at 85% 70%,#d9eba422,transparent 46%),var(--surface)}.closing h2{margin:0;font-size:clamp(1.8rem,3vw,2.7rem);line-height:1.25;letter-spacing:-.07em}.closing p{max-width:470px;color:var(--muted);font-size:.85rem}.closing div:last-child a{display:inline-block;margin:4px 8px 0 0;padding:8px 13px;border:1px solid var(--line);border-radius:99px;font-size:.72rem;font-weight:750}.closing div:last-child a:hover{color:var(--accent);border-color:var(--accent)}
@media(max-width:900px){.timeline,.cat{grid-column:span 6}.intro-orbit{opacity:.35}}@media(max-width:720px){.home{padding-top:50px}.home-top{display:block}.home-search{width:100%;margin-top:24px}.bento-card{grid-column:span 12;min-height:auto!important}.intro{min-height:390px!important}.note{min-height:340px!important}.feature{min-height:370px!important}.cat{min-height:330px!important}.closing{min-height:300px!important}.bento-grid{gap:11px}}@media(max-width:430px){h1{font-size:clamp(2.7rem,13vw,3.7rem)}.bento-card{padding:24px;border-radius:23px}.intro-orbit{width:90px;height:90px;right:20px;top:66px;font-size:.45rem}.feature-art{right:-200px}}
</style>
