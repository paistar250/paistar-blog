---
import { Image,getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts,categories,tags,termSlug } from '../lib/blog';
import { art,artAlts,categoryArt,categoryEmojis } from '../data/art';
import { site } from '../data/site';
const mobileHero=await getImage({src:art.hello,width:800,format:'webp',quality:85});
const posts=await getPosts();
const sorted=[...posts].sort((a,b)=>Number(b.data.pinned)-Number(a.data.pinned)||b.data.date.valueOf()-a.data.date.valueOf());
const categoryList=categories(posts);
const tagList=tags(posts);
const schema={ '@context':'https://schema.org','@type':'Blog',name:site.title,description:site.description,url:new URL('/journal/',Astro.site).toString(),author:{'@type':'Person',name:site.author}};
---
<BaseLayout schema={schema}>
<section class="blog-hero" aria-labelledby="blog-title"><picture><source media="(max-width:560px)" srcset={mobileHero.src}/><Image src={art.hero} alt={artAlts.hero} width={2200} height={900} widths={[800,1400,2200]} sizes="100vw" format="webp" quality={85} loading="eager" fetchpriority="high"/></picture><div class="hero-shade"></div><div class="hero-title"><span>PAISTAR JOURNAL</span><h1 id="blog-title">Paistar 手记</h1><p>技术 · 阅读 · 日常</p></div><a class="scroll-hint" href="#recent" aria-label="浏览最新文章">⌄</a></section>
<div class="shell journal-layout" id="recent">
<div class="journal-main">
<div class="topic-strip">{categoryList.map(item=><a class="topic-tile" href={'/categories/'+item.slug+'/'}><Image src={art[categoryArt[item.name]||'notes']} alt="" width={500} height={260} format="webp" quality={80}/><div><strong>{categoryEmojis[item.name]} {item.name}</strong><small>{item.count} 篇</small></div></a>)}</div>
<div class="section-heading"><h2>✍️ 最新文章</h2><a class="text-link" href="/archive/">全部 {posts.length} 篇 →</a></div>
<div class="post-grid">{sorted.slice(0,8).map((post,index)=><PostCard post={post} index={index}/>)}</div>
<div class="archive-more"><a href="/archive/">🗂️ 按时间翻阅 →</a></div>
</div>
<aside class="journal-sidebar" aria-label="作者与文章导航">
<section class="side-card profile-card"><Image class="profile-cover" src={art.notes} alt="" width={560} height={230} format="webp" quality={81}/><button class="profile-avatar" data-profile-cat type="button" aria-label="换一句问候"><img src="/avatar.webp" alt="Paistar 的头像" width="70" height="70"/></button><h2>Paistar</h2><p data-cat-message aria-live="polite">记录一点，生活一点。</p><div class="profile-stats"><a href="/archive/"><strong>{posts.length}</strong><span>文章</span></a><a href="/categories/"><strong>{categoryList.length}</strong><span>分类</span></a><a href="/tags/"><strong>{tagList.length}</strong><span>标签</span></a></div><a class="profile-about" href="/about/">关于我 →</a><div class="profile-social"><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="/rss.xml">📡 RSS</a></div></section>
<section class="side-card"><div class="side-padding"><h2>📂 分类</h2><div class="side-categories">{categoryList.map(item=><a href={'/categories/'+item.slug+'/'}><span>{categoryEmojis[item.name]} {item.name}</span><small>{item.count}</small></a>)}</div></div><a class="side-photo" href="/categories/" aria-label="浏览分类"><Image src={art.design} alt={artAlts.design} width={560} height={220} format="webp" quality={80}/></a></section>
<section class="side-card"><div class="side-padding"><h2>🏷️ 标签</h2><div class="side-tags">{tagList.map(tag=><a href={'/tags/'+termSlug(tag.name)+'/'}>{tag.name}</a>)}</div></div><a class="side-photo" href="/tags/" aria-label="浏览标签"><Image src={art.life} alt={artAlts.life} width={560} height={220} format="webp" quality={80}/></a></section>
<a class="side-contact" href="/contact/"><span>📮</span><div><strong>打个招呼</strong><small>联系与交流 →</small></div></a>
</aside>
</div>
<script>
const cat=document.querySelector<HTMLButtonElement>('[data-profile-cat]');
const text=document.querySelector<HTMLElement>('[data-cat-message]');
const words=['今天也要开心。','欢迎常来坐坐。','读一篇，再喝杯茶。','记录一点，生活一点。'];
let index=0;cat?.addEventListener('click',()=>{if(text)text.textContent=words[index++%words.length];cat.classList.toggle('greeting-wave')});
</script>
</BaseLayout>
<style>
.blog-hero{position:relative;display:grid;place-items:center;min-height:535px;margin-top:-79px;overflow:hidden;background:#eeece7}.blog-hero>picture{position:absolute;inset:0}.blog-hero>picture>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 45%}.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,#15273b26,#13273a24 45%,#15253666)}.hero-title{position:relative;z-index:1;color:#fff;text-align:center;padding:100px 24px 45px;text-shadow:none}.hero-title>span{font-size:.65rem;letter-spacing:.3em;opacity:.85}.hero-title h1{font-family:var(--font-editorial);margin:12px 0 8px;font-size:clamp(2.6rem,4.3vw,4.15rem);line-height:1.3;font-weight:650;letter-spacing:.06em}.hero-title p{font-size:.9rem;letter-spacing:.25em;margin:0;color:#edf2f6}.scroll-hint{position:absolute;left:50%;bottom:24px;transform:translateX(-50%);font-size:2rem;color:#fff;line-height:1}.scroll-hint:hover{color:#fff;transform:translateX(-50%) translateY(3px)}.journal-layout{display:grid;grid-template-columns:minmax(0,1fr) 278px;gap:26px;margin-top:36px;scroll-margin-top:110px}.journal-main{min-width:0}.topic-strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px;margin-bottom:32px}.topic-tile{position:relative;min-width:0;overflow:hidden;aspect-ratio:1.65;border-radius:15px;background:var(--surface);box-shadow:var(--shadow);transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s}.topic-tile:hover{box-shadow:var(--card-hover-shadow)}.topic-tile img{width:100%;height:100%;object-fit:cover;transition:transform .6s}.topic-tile:after{content:"";position:absolute;inset:0;background:linear-gradient(transparent,#101d2bc4)}.topic-tile:hover img{transform:scale(1.05)}.topic-tile>div{position:absolute;bottom:15px;left:17px;right:17px;z-index:1;color:#fff;display:flex;align-items:center;justify-content:space-between;gap:5px}.topic-tile strong{font-size:.85rem;font-weight:600}.topic-tile small{font-size:.65rem;opacity:.8}.archive-more{margin-top:28px;text-align:center}.archive-more a{display:inline-flex;padding:9px 19px;border:1px solid var(--line);border-radius:99px;font-size:.8rem;background:var(--surface);color:var(--muted)}.archive-more a:hover{color:var(--accent);border-color:var(--accent)}
.journal-sidebar{display:flex;flex-direction:column;gap:22px;align-self:start}.side-card{overflow:hidden;border:0;border-radius:20px;background:var(--surface);box-shadow:var(--shadow)}.profile-card{text-align:center}.profile-cover{width:100%;height:105px;object-fit:cover}.profile-avatar{position:relative;display:block;width:78px;height:78px;margin:-39px auto 12px;padding:0;border:4px solid var(--surface);border-radius:50%;background:var(--surface);box-shadow:0 3px 12px #00000020;transition:transform .3s}.profile-avatar:hover{transform:translateY(-3px) rotate(-3deg)}.profile-avatar.greeting-wave{transform:rotate(5deg)}.profile-card h2{font-size:1.2rem;letter-spacing:.01em;margin:5px 0 4px;font-weight:650}.profile-card p{margin:0 0 22px;color:var(--muted);font-size:.76rem}.profile-stats{display:grid;grid-template-columns:repeat(3,1fr);padding:0 24px}.profile-stats a{display:flex;flex-direction:column;line-height:1.5}.profile-stats strong{font-size:1.15rem;font-weight:600}.profile-stats span{font-size:.7rem;color:var(--muted);margin-top:3px}.profile-about{display:block;margin:22px 24px 17px;padding:8px;border-radius:11px;background:var(--surface-2);font-size:.78rem;transition:background .25s,color .25s}.profile-about:hover{background:var(--surface-3)}.profile-social{display:flex;justify-content:center;gap:25px;padding:0 20px 22px;color:var(--muted);font-size:.7rem}.side-padding{padding:24px}.side-card h2{font-size:.95rem;font-weight:600;margin:0 0 18px}.side-categories{display:grid;gap:10px;font-size:.8rem}.side-categories a{display:flex;justify-content:space-between;gap:10px}.side-categories small{color:var(--muted)}.side-photo{display:block;height:94px;overflow:hidden}.side-photo img{width:100%;height:100%;object-fit:cover;transition:transform .6s}.side-photo:hover img{transform:scale(1.05)}.side-tags{display:flex;flex-wrap:wrap;gap:7px}.side-tags a{padding:3px 9px;border:0;background:var(--surface-2);border-radius:7px;color:var(--muted);font-size:.7rem}.side-tags a:hover{border-color:var(--accent);color:var(--accent)}.side-contact{display:flex;align-items:center;gap:15px;padding:22px;border:0;border-radius:20px;background:var(--surface);box-shadow:var(--shadow);transition:transform .25s,box-shadow .25s}.side-contact:hover{transform:translateY(-3px);box-shadow:var(--card-hover-shadow)}.side-contact>span{font-size:1.8rem}.side-contact strong{display:block;font-size:.87rem;font-weight:600}.side-contact small{display:block;color:var(--muted);font-size:.7rem;margin-top:3px}
@media(max-width:1050px){.journal-layout{grid-template-columns:minmax(0,1fr) 245px;gap:20px}.topic-tile>div{left:13px;right:13px}.topic-tile small{display:none}.topic-tile strong{font-size:.75rem}.post-grid{gap:18px}}
@media(max-width:820px){.journal-layout{grid-template-columns:1fr}.journal-sidebar{display:grid;grid-template-columns:1fr 1fr}.profile-card{grid-row:span 2}.side-contact{grid-column:1/-1}.topic-tile small{display:block}}
@media(max-width:560px){.blog-hero{min-height:410px;margin-top:-69px}.hero-title{padding-top:75px}.hero-title h1{font-size:2.5rem}.hero-title p{font-size:.77rem}.hero-title>span{font-size:.58rem}.journal-layout{margin-top:25px;gap:32px}.topic-strip{gap:9px;margin-bottom:28px}.topic-tile{aspect-ratio:1.05;border-radius:12px}.topic-tile>div{left:10px;right:8px;bottom:11px}.topic-tile strong{font-size:.68rem}.topic-tile small{display:none}.section-heading{margin-bottom:16px}.section-heading h2{font-size:1.13rem}.journal-sidebar{display:flex;gap:18px}.profile-cover{height:135px}.side-photo{height:120px}}

.profile-avatar img{width:100%;height:100%;object-fit:cover;border-radius:50%}.hero-title>span{color:#e9edf1}@media(max-width:560px){.blog-hero>picture>img{opacity:1;object-position:center}.hero-title{padding-bottom:35px}.hero-title h1{font-size:2.3rem}}
@media(max-width:560px){.journal-sidebar>.side-card:not(.profile-card){display:none}}</style>
