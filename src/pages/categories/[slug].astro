---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getPosts,categories,decodeTerm } from '../../lib/blog';
import { categoryArt,categoryEmojis } from '../../data/art';
const all=await getPosts();
const category=categories(all).find(item=>decodeTerm(item.slug)===decodeTerm(Astro.params.slug||''));
if(!category)return Astro.rewrite('/404');
const name=category.name;
const posts=all.filter(post=>post.data.category===name);
---
<BaseLayout title={name}><PageHeader title={(categoryEmojis[name]||'📂')+' '+name} subtitle={posts.length+' 篇文章'} artwork={categoryArt[name]||'notes'}/><div class="shell post-grid">{posts.map(post=><PostCard post={post}/>)}</div></BaseLayout>
