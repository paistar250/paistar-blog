---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getPosts,categories } from '../../lib/blog';
import { art,categoryArt,categoryEmojis } from '../../data/art';
const list=categories(await getPosts());
---
<BaseLayout title="分类"><PageHeader title="📂 文章分类" artwork="design"/><div class="shell category-grid">{list.map(item=><a href={'/categories/'+item.slug+'/'}><Image src={art[categoryArt[item.name]||'notes']} alt="" width={800} height={600} format="webp" quality={83}/><div><h2>{categoryEmojis[item.name]} {item.name}</h2><span>{item.count} 篇文章 →</span></div></a>)}</div></BaseLayout>
<style>.category-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.category-grid a{position:relative;overflow:hidden;aspect-ratio:1.3;border-radius:20px;background:var(--surface);box-shadow:var(--shadow);transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s}.category-grid a:hover{box-shadow:var(--card-hover-shadow)}.category-grid img{width:100%;height:100%;object-fit:cover;transition:transform .6s}.category-grid a:hover img{transform:scale(1.04)}.category-grid a:after{content:"";position:absolute;inset:0;background:linear-gradient(transparent,#101d2cd9)}.category-grid a>div{position:absolute;left:25px;bottom:23px;z-index:1;color:#fff}.category-grid h2{font-weight:600;font-size:1.35rem;margin:0 0 4px}.category-grid span{font-size:.75rem;opacity:.8}@media(max-width:700px){.category-grid{grid-template-columns:1fr;gap:16px}.category-grid a{aspect-ratio:1.85}}</style>
