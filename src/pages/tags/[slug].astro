---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getPosts,tags,decodeTerm } from '../../lib/blog';
const all=await getPosts();
const tag=tags(all).find(item=>decodeTerm(item.slug)===decodeTerm(Astro.params.slug||''));
if(!tag)return Astro.rewrite('/404');
const name=tag.name;
const posts=all.filter(post=>post.data.tags.includes(name));
---
<BaseLayout title={'#'+name}><PageHeader title={'# '+name} subtitle={posts.length+' 篇文章'} artwork="hello"/><div class="shell post-grid">{posts.map(post=><PostCard post={post}/>)}</div></BaseLayout>
