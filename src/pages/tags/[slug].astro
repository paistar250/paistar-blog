---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getPosts,tags,type Post } from '../../lib/blog';
interface Props { name:string; posts:Post[]; }
export async function getStaticPaths(){const posts=await getPosts();return tags(posts).map(item=>({params:{slug:item.slug},props:{name:item.name,posts:posts.filter(post=>post.data.tags.includes(item.name))}}))}
const {name,posts}=Astro.props;
---
<BaseLayout title={'#'+name}><PageHeader title={'# '+name} subtitle={posts.length+' 篇文章'} artwork="hello"/><div class="shell post-grid">{posts.map(post=><PostCard post={post}/>)}</div></BaseLayout>
