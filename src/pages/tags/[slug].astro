---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, tags, type Post } from '../../lib/blog';
interface Props { name: string; posts: Post[]; }
export async function getStaticPaths() { const posts = await getPosts(); return tags(posts).map((item) => ({ params: { slug: item.slug }, props: { name: item.name, posts: posts.filter((post) => post.data.tags.includes(item.name)) } })); }
const { name, posts } = Astro.props;
---
<BaseLayout title={`#${name} · 标签`} description={`浏览「${name}」标签下的 ${posts.length} 篇文章。`}><div class="shell page-hero"><span class="eyebrow">TAG / {posts.length} ARTICLES</span><h1>#{name}</h1><p>与这个关键词有关的记录。</p></div><div class="shell post-grid">{posts.map((post, index) => <PostCard post={post} index={index} />)}</div></BaseLayout>
