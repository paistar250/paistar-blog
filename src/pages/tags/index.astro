---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getPosts,tags } from '../../lib/blog';
const list=tags(await getPosts());
---
<BaseLayout title="标签"><PageHeader title="🏷️ 文章标签" artwork="hello"/><div class="narrow panel tag-list">{list.map(item=><a href={'/tags/'+item.slug+'/'}><span># {item.name}</span><small>{item.count}</small></a>)}</div></BaseLayout>
<style>.tag-list{display:flex;flex-wrap:wrap;justify-content:center;gap:14px;padding-block:40px}.tag-list a{display:flex;align-items:center;gap:15px;padding:10px 17px;border:1px solid var(--line);border-radius:99px;font-size:.9rem}.tag-list a:hover{border-color:var(--accent);background:var(--surface-2)}.tag-list small{color:var(--muted);font-size:.7rem}</style>
