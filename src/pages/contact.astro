---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
---
<BaseLayout title="联系"><PageHeader title="📮 打个招呼" artwork="design"/><div class="narrow contact-grid"><a class="panel" href={site.github} target="_blank" rel="noopener noreferrer"><span>💬</span><h2>GitHub</h2><p>交流与反馈 ↗</p></a><a class="panel" href="/rss.xml"><span>📡</span><h2>RSS</h2><p>订阅文章更新 →</p></a>{site.email&&<a class="panel" href={'mailto:'+site.email}><span>✉️</span><h2>Email</h2><p>{site.email} ↗</p></a>}</div></BaseLayout>
<style>.contact-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.contact-grid>a>span{font-size:2rem}.contact-grid h2{font-size:1.25rem;font-weight:600;margin:17px 0 5px}.contact-grid p{font-size:.8rem;color:var(--muted);margin:0}.contact-grid>a:hover{border-color:var(--accent)}@media(max-width:500px){.contact-grid{grid-template-columns:1fr}}</style>
