---
import ThemeInit from '../components/ThemeInit.astro';
import ThemeButton from '../components/ThemeButton.astro';
import StickerScene from '../components/StickerScene.astro';
import '../styles/global.css';
import '../styles/auth.css';
interface Props { title:string; }
const {title}=Astro.props;
---
<!doctype html><html lang="zh-CN" data-theme="dark"><head><meta charset="utf-8"/><ThemeInit/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#20262c"/><meta name="robots" content="noindex,follow"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><title>{title} · Paistar 手记</title></head>
<body><main class="auth-page"><div class="auth-visual"><StickerScene/></div><a class="auth-brand" href="/journal/"><span class="brand-mark">P.</span>Paistar</a><div class="auth-controls"><button class="icon-button auth-info-button" type="button" aria-label="账号说明" title="账号说明" data-account-info>?</button><ThemeButton/></div><section class="auth-panel"><div class="auth-inner"><slot/></div></section></main>
<dialog class="account-dialog" aria-labelledby="account-help-heading"><h2 id="account-help-heading">关于账号</h2><p>这是浏览器本地账号，不用于保护内容。密码经加盐校验后保存，不会上传。文章始终公开，清除浏览器数据会移除账号。</p><form method="dialog"><button class="button" type="submit">知道了</button></form></dialog>
<script>
const dialog=document.querySelector<HTMLDialogElement>('.account-dialog');
document.querySelector('[data-account-info]')?.addEventListener('click',()=>dialog?.showModal());
dialog?.addEventListener('click',event=>{if(event.target===dialog){const box=dialog.getBoundingClientRect();if(event.clientX<box.left||event.clientX>box.right||event.clientY<box.top||event.clientY>box.bottom)dialog.close()}});
document.querySelectorAll<HTMLButtonElement>('[data-password-toggle]').forEach(button=>button.addEventListener('click',()=>{const input=button.parentElement?.querySelector<HTMLInputElement>('input');if(input){input.type=input.type==='password'?'text':'password';button.setAttribute('aria-label',input.type==='password'?'显示密码':'隐藏密码')}}));
</script></body></html>
